# Database (SQLite for quick local start; swap to PostgreSQL for production)
# SQLite (default, zero setup):
DATABASE_URL="file:./dev.db"

# PostgreSQL (production example):
# DATABASE_URL="postgresql://user:password@localhost:5432/kasir_toko?schema=public"

# App
NEXT_PUBLIC_APP_NAME="Toko Kasir"

# Auth — used to sign the login session cookie (lib/auth/session.ts).
# Generate a real random value for this, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-this-with-a-long-random-string"
